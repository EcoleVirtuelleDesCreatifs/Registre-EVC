APP_NAME="Registre officiel EVC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Abidjan
APP_URL=https://verification.ecolevirtuelledescreatifs.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Base de données : MySQL en production (ou sqlite pour un test rapide)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evc_registre
DB_USERNAME=evc
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Premier compte administrateur (créé par : php artisan db:seed)
ADMIN_NAME="Bossombra Bile"
ADMIN_EMAIL=info@ecolevirtuelledescreatifs.com
ADMIN_PASSWORD=

# Coordonnées affichées sur la page publique
EVC_CONTACT_EMAILS="info@ecolevirtuelledescreatifs.com,amandine_kra@ecolevirtuelledescreatifs.com"

# Double authentification obligatoire pour ces rôles (séparés par des virgules)
EVC_2FA_ROLES="direction_generale,admin_systeme"

# Jeton de l'API My EVC (64 caractères aléatoires : php -r "echo bin2hex(random_bytes(32));")
# Laisser vide pour désactiver l'API.
EVC_API_TOKEN=

# Nombre de sauvegardes automatiques conservées
EVC_BACKUPS_KEEP=30

# Cérémonie de remise des certificats (affichée dans le mail au titulaire)
EVC_CEREMONIE_DATE=
EVC_CEREMONIE_LIEU="Abidjan"
